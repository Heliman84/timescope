{
    "name": "timescope",
    "displayName": "TimeScope",
    "description": "A VS Code extension for tracking work sessions with analytics and a dashboard.",
    "publisher": "davidclass",
    "version": "0.8.0",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "configuration": {
            "title": "TimeScope",
            "properties": {
                "timescope.global_storage_dir": {
                    "type": "string",
                    "description": "Folder where TimeScope stores global jobs.json and logs.jsonl.",
                    "format": "folder",
                    "default": ""
                }
            }
        },
        "commands": [
            {
                "command": "timescope.start",
                "title": "Start",
                "category": "TimeScope"
            },
            {
                "command": "timescope.pause",
                "title": "Pause",
                "category": "TimeScope"
            },
            {
                "command": "timescope.resume",
                "title": "Resume",
                "category": "TimeScope"
            },
            {
                "command": "timescope.stop",
                "title": "Stop",
                "category": "TimeScope"
            },
            {
                "command": "timescope.dashboard",
                "title": "Show Summary Dashboard",
                "category": "TimeScope"
            },
            {
                "command": "timescope.renameJob",
                "title": "Rename Job",
                "category": "TimeScope"
            },
            {
                "command": "timescope.showBuildInfo",
                "title": "Show Build Info",
                "category": "TimeScope"
            },
            {
                "command": "timescope.compactLog",
                "title": "Compact Log",
                "category": "TimeScope"
            },
            {
                "command": "timescope.rebuildGlobalIndex",
                "title": "Rebuild Global Index",
                "category": "TimeScope"
            },
            {
                "command": "timescope.showStorageStatus",
                "title": "Show Storage Status",
                "category": "TimeScope"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "copy-dashboard": "node -e \"const fs=require('fs');fs.mkdirSync('out/dashboard/webview',{recursive:true});fs.cpSync('src/dashboard/webview','out/dashboard/webview',{recursive:true});\"",
        "vscode:prepublish": "npm run compile && npm run copy-dashboard && npm run write-buildinfo",
        "test": "npm run compile && node ./out/test/run_tests.js",
        "test:ui": "playwright test",
        "seed-testdata": "npm run compile && node scripts/seed_test_data.js",
        "write-buildinfo": "node scripts/write_buildinfo.js",
        "package": "npm run vscode:prepublish && vsce package"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.85.0",
        "@vscode/vsce": "^3.0.0",
        "typescript": "^5.4.0",
        "vscode": "^1.1.34"
    },
    "icon": "icon.png",
    "files": [
        "out/",
        "README.md",
        "LICENSE.md",
        "package.json",
        "icon.png"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Heliman84/timescope.git"
    }
}
