node_modules/
out/
*.vsix

# Local test artifacts
/test-output/
/test-results/
/playwright-report/

# Node / build artifacts
dist/
build/

# Logs and env
*.log
npm-debug.log*
.env

# OS / editor files
.DS_Store
.vscode/*.local

# Ignore everything in .vscode
.vscode/*

# But DO track these specific files
!.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Test-workspace: track the settings that pin TimeScope storage,
# but never commit the test tracking data itself
!test-workspace/.vscode/settings.json
test-workspace/global-storage/*
!test-workspace/global-storage/.gitkeep
