node_modules/
out/
*.vsix

# Local test artifacts
/test-output/
/test-results/
/playwright-report/
/.playwright-mcp/

# Node / build artifacts
dist/
build/

# Logs and env
*.log
npm-debug.log*
.env

# OS / editor files
.DS_Store
.vscode/*.local

# Ignore everything in .vscode
.vscode/*

# But DO track these specific files
!.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Test-workspace: track the settings that pin TimeScope storage,
# but never commit the test tracking data itself
!test-workspace/.vscode/settings.json
test-workspace/global-storage/*
!test-workspace/global-storage/.gitkeep
test-workspace/.timescope/

# Test-workspace-empty: isolated F5 fixture for the opt-in flow (#48);
# track its pinned settings, never commit its tracking data
!test-workspace-empty/.vscode/settings.json
test-workspace-empty/global-storage/*
!test-workspace-empty/global-storage/.gitkeep

# Test-multi: two-repo shared-global fixture for multi-instance F5 (#48/#47).
# Track the pinned settings + shared-global placeholder; regen data via scripts.
test-multi/repoA/.timescope/
test-multi/repoB/.timescope/
test-multi/shared-global/*
!test-multi/shared-global/.gitkeep
test-workspace-empty/.timescope/

# Test-workspace-legacy: v0.2.0-style repo (log, no config) for the US-06 F5 test
test-workspace-legacy/.timescope/
test-workspace-legacy/global-storage/*
!test-workspace-legacy/global-storage/.gitkeep
