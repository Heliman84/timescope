{
    "version": "0.2.0",
    "configurations": [
        {
        "name": "Run TimeScope Extension",
        "type": "extensionHost",
        "request": "launch",
        "runtimeExecutable": "${execPath}",
        "args": [
            "--disable-extensions",
            "--extensionDevelopmentPath=${workspaceFolder}",
            "${workspaceFolder}/test-workspace"
        ],
        "outFiles": [
            "${workspaceFolder}/out/**/*.js"
        ],
        "preLaunchTask": "build-timescope",
        "env": {
            "NODE_ENV": "development"
        }
        }
    ]
}